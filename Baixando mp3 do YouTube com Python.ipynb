from pathlib import Path

from pytubefix import YouTube
from moviepy import AudioFileClip


link = input("Digite o link do vídeo do YouTube: ").strip()
pasta = Path(input("Digite a pasta onde deseja salvar o áudio: ").strip()).expanduser()

pasta.mkdir(parents=True, exist_ok=True)

print("Buscando stream de áudio...")
video = YouTube(link)
stream = video.streams.filter(only_audio=True).first()

if stream is None:
    raise ValueError("Nenhum stream de áudio disponível para este vídeo.")

print("Baixando...")
arquivo_baixado = Path(stream.download(output_path=str(pasta)))
print(f"Áudio baixado em: {arquivo_baixado}")

arquivo_mp3 = arquivo_baixado.with_suffix(".mp3")
audio = AudioFileClip(str(arquivo_baixado))

try:
    audio.write_audiofile(
        str(arquivo_mp3),
        codec="libmp3lame",
        logger=None,
    )
finally:
    audio.close()

if arquivo_baixado.resolve() != arquivo_mp3.resolve():
    arquivo_baixado.unlink()

print(f"Conversão concluída: {arquivo_mp3}")
